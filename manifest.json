{
  "schema": 1,
  "id": "valet-exec",
  "name": "Exec",
  "version": "0.1.0",
  "description": "exec and process tools: shell jobs that outlive valet: systemd units on Linux, launchd jobs on macOS, detached supervisors on Windows.",
  "repository": "https://github.com/valethq/valet-exec",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1"],
  "events": { "namespace": "exec" },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runner": { "type": "string", "enum": ["auto", "systemd", "launchd", "detached", "supervisor"] },
      "shell": { "type": "string" },
      "yieldMs": { "type": "number" },
      "inheritEnv": { "type": "boolean" },
      "onExit": { "type": "string", "enum": ["notify", "none"] },
      "logRetentionDays": { "type": "number" },
      "headBytes": { "type": "number" },
      "tailBytes": { "type": "number" }
    }
  }
}
