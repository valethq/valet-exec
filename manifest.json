{
  "schema": 1,
  "id": "valet-exec",
  "name": "Exec",
  "version": "0.1.0",
  "description": "exec and process tools: shell jobs that outlive valet: systemd units on Linux, launchd jobs on macOS, detached supervisors on Windows.",
  "repository": "https://github.com/valethq/valet-exec",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1"],
  "events": {
    "namespace": "exec"
  },
  "settings": {
    "sections": {
      "tools": {
        "subsections": [
          {
            "id": "jobs",
            "label": "Jobs",
            "items": [
              {
                "id": "runner",
                "label": "Runner",
                "apply": "restart",
                "summary": "How jobs detach from valet. auto picks systemd on Linux and launchd on macOS when they work.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "auto",
                      "label": "Auto"
                    },
                    {
                      "value": "systemd",
                      "label": "systemd"
                    },
                    {
                      "value": "launchd",
                      "label": "launchd"
                    },
                    {
                      "value": "detached",
                      "label": "Detached"
                    },
                    {
                      "value": "supervisor",
                      "label": "Supervisor"
                    }
                  ],
                  "style": "segmented",
                  "default": "auto"
                }
              },
              {
                "id": "shell",
                "label": "Shell",
                "summary": "Shell that runs each command. Blank uses the host default.",
                "input": {
                  "type": "string"
                }
              },
              {
                "id": "yieldMs",
                "label": "Yield (ms)",
                "summary": "How long an exec call waits before backgrounding. Cap 600000.",
                "input": {
                  "type": "number",
                  "unit": "duration",
                  "min": 0,
                  "max": 600000,
                  "default": 10000
                }
              },
              {
                "id": "inheritEnv",
                "label": "Inherit valet's environment",
                "input": {
                  "type": "bool",
                  "default": true
                }
              },
              {
                "id": "onExit",
                "label": "When a background job ends",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "notify",
                      "label": "Notify the model"
                    },
                    {
                      "value": "none",
                      "label": "Stay quiet"
                    }
                  ],
                  "style": "segmented",
                  "default": "notify"
                }
              },
              {
                "id": "logRetentionDays",
                "label": "Log retention (days)",
                "input": {
                  "type": "number",
                  "min": 1,
                  "default": 14
                },
                "advanced": true
              },
              {
                "id": "headBytes",
                "label": "Result head bytes",
                "input": {
                  "type": "number",
                  "unit": "bytes",
                  "min": 0,
                  "default": 2048
                },
                "advanced": true
              },
              {
                "id": "tailBytes",
                "label": "Result tail bytes",
                "input": {
                  "type": "number",
                  "unit": "bytes",
                  "min": 0,
                  "default": 30720
                },
                "advanced": true
              }
            ]
          }
        ],
        "icon": "terminal",
        "order": 10
      }
    }
  }
}
