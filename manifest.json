{
  "schema": 1,
  "id": "valet-exec",
  "name": "Exec",
  "version": "0.1.0",
  "description": "exec and process tools: shell jobs that run in their own systemd units and outlive valet.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["tools@1"],
  "events": { "namespace": "exec" },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runner": { "type": "string", "enum": ["auto", "systemd", "detached"] },
      "shell": { "type": "string" },
      "yieldMs": { "type": "number" },
      "inheritEnv": { "type": "boolean" },
      "onExit": { "type": "string", "enum": ["notice", "wake", "none"] },
      "logRetentionDays": { "type": "number" },
      "headBytes": { "type": "number" },
      "tailBytes": { "type": "number" }
    }
  }
}
